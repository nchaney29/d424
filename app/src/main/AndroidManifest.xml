<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="D424 Book Tracker"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.D424BookTracker">

        <receiver
            android:name=".UI.MyReceiver"
            android:enabled="true"
            android:exported="true"/>

        <activity
            android:name=".UI.MainActivity"
            android:exported="true"
            android:label="Main"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".UI.BookList"
            android:exported="false"
            android:label="Book List"
            android:parentActivityName=".UI.MainActivity"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".UI.BookDetails"
            android:exported="false"
            android:label="Book Details"
            android:parentActivityName=".UI.BookList"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".UI.RegisterUser"
            android:exported="false"
            android:label="User Registration"
            android:parentActivityName=".UI.MainActivity"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".UI.LoginUser"
            android:exported="false"
            android:label="User Login"
            android:parentActivityName=".UI.MainActivity"
            android:windowSoftInputMode="adjustResize" />
<!--        <activity-->
<!--            android:name=".UI.ExcursionDetails"-->
<!--            android:label="Excursion Details"-->
<!--            android:parentActivityName=".UI.BookDetails"-->
<!--            android:exported="false"-->
<!--            android:windowSoftInputMode="adjustResize" />-->
    </application>

</manifest>