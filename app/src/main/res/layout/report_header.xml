<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">


    <TextView
        android:id="@+id/reportText"
        android:layout_width="53dp"
        android:layout_height="31dp"
        android:layout_marginStart="10dp"
        android:layout_marginTop="44dp"
        android:text="Title"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/reportText2"
        android:layout_width="53dp"
        android:layout_height="31dp"
        android:layout_marginStart="37dp"
        android:layout_marginTop="44dp"
        android:text="Author"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@+id/reportText"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/reportText3"
        android:layout_width="71dp"
        android:layout_height="32dp"
        android:layout_marginStart="44dp"
        android:layout_marginTop="44dp"
        android:text="Start Date"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@+id/reportText2"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/reportText4"
        android:layout_width="87dp"
        android:layout_height="29dp"
        android:layout_marginStart="28dp"
        android:layout_marginTop="44dp"
        android:text="Finish Date"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@+id/reportText3"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>